[Unit]
Description=PKHosting daily backup

[Service]
Type=oneshot
# PK panel backup.py (ruta de instalación, la escribe install.sh)
ExecStart=@APP_DIR@/backup.py --run
# Un backup grande no debe competir con el servidor de Minecraft por CPU ni disco
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
NoNewPrivileges=yes
UMask=0077
